{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "origin-ai/schemas/trace.schema.json",
  "title": "実行トレース（1行1ステップ）",
  "description": "本文は絶対に書かない。ハッシュと artifacts へのポインタのみ。additionalProperties:false が本文混入の防波堤になっている。",
  "type": "object",
  "required": [
    "trace_id", "plan_id", "plan_revision", "step_id",
    "skill_id", "skill_version", "model_id", "prompt_hash", "pricing_version",
    "input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens",
    "cost_usd", "latency_ms", "started_at", "ended_at",
    "status", "gates_triggered", "approval_ref", "data_class",
    "inputs_hash", "outputs_hash", "artifact_refs", "retry_count", "error_class"
  ],
  "additionalProperties": false,
  "properties": {
    "trace_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "step_id": {"type": "string"},
    "skill_id": {"type": "string"},
    "skill_version": {"type": "string"},

    "model_id": {"type": ["string", "null"], "description": "実行層のみのステップは null"},
    "prompt_hash": {"type": ["string", "null"]},
    "pricing_version": {"type": "string"},

    "input_tokens": {"type": "integer", "minimum": 0},
    "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
    "cache_read_input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},

    "cost_usd": {"type": "number", "minimum": 0},
    "latency_ms": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},

    "status": {
      "enum": ["ok", "blocked", "error", "waiting_approval", "skipped_idempotent", "dry_run"]
    },
    "block_reason": {"type": ["string", "null"]},
    "gates_triggered": {"type": "array", "items": {"type": "string"}},
    "approval_ref": {"type": ["string", "null"]},
    "data_class": {"enum": ["public", "internal", "pii", "privileged"]},

    "inputs_hash": {"type": "string"},
    "outputs_hash": {"type": ["string", "null"]},
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "成果物へのパスのみ。内容そのものは書かない"
    },
    "retry_count": {"type": "integer", "minimum": 0},
    "error_class": {"type": ["string", "null"]}
  }
}
